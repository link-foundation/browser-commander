st_id}","starred_url":"https://api.github.com/users/konard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/konard/subscriptions","organizations_url":"https://api.github.com/users/konard/orgs","repos_url":"https://api.github.com/users/konard/repos","events_url":"https://api.github.com/users/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f835f3ba14ed9d95f3cc05562383455dc3f13fff","url":"https://api.github.com/repos/link-assistant/hive-mind/commits/f835f3ba14ed9d95f3cc05562383455dc3f13fff","html_url":"https://github.com/link-assistant/hive-mind/commit/f835f3ba14ed9d95f3cc05562383455dc3f13fff"}]},{"sha":"e824155d0e9dfdbe8293ae3dc704fa36ac71496b","node_id":"C_kwDOPUU0qdoAKGU4MjQxNTVkMGU5ZGZkYmU4MjkzYWUzZGM3MDRmYTM2YWM3MTQ5NmI","commit":{"author":{"name":"konard","email":"drakonard@gmail.com","date":"2026-07-16T17:58:07Z"},"committer":{"name":"konard","email":"drakonard@gmail.com","date":"2026-07-16T17:58:07Z"},"message":"docs(ci-cd): document the Bug type and the omitted prompt paragraphs\n\nIssue #1733 asks for docs/CI-CD-BEST-PRACTICES.md to be fully updated in all\nlanguages. The remediation section still described the old\n`/solve --auto-merge` handoff.\n\n- Record the new handoff: /solve --development-log --deep-analysis --auto-merge.\n- Explain why the generated issue is a Bug: /solve only emits the root-cause\n  wording for bug-typed issues, which is what makes omitting those paragraphs\n  from the issue text lossless rather than lossy.\n- Note the best-effort fallback when a repository has neither issue types nor\n  the label, and that a paragraph is dropped only when every option providing\n  it is enabled.\n\nMirrored across en/zh/hi/ru.","tree":{"sha":"d5d84c43fce726a6049b4dc78dee0330a8beca7e","url":"https://api.github.com/repos/link-assistant/hive-mind/git/trees/d5d84c43fce726a6049b4dc78dee0330a8beca7e"}
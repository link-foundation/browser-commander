{
  "name": "browser-commander",
  "version": "0.26.0",
  "description": "Universal browser automation library that supports Playwright, Puppeteer, and Selenium with a unified API",
  "main": "src/index.js",
  "bin": {
    "browser-commander": "bin/browser-commander.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./tests": "./src/tests/index.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs --reporter spec tests/unit",
    "test:unit": "node scripts/run-tests.mjs --reporter spec tests/unit",
    "test:coverage": "node scripts/run-tests.mjs --coverage tests/unit",
    "test:e2e": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e",
    "test:e2e:playwright": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/playwright.e2e.test.js",
    "test:e2e:puppeteer": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/puppeteer.e2e.test.js",
    "test:e2e:webdriver": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/webdriver.e2e.test.js",
    "test:e2e:parity": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/fingerprint-parity.e2e.test.js tests/e2e/measure-parity.e2e.test.js",
    "test:e2e:click-readiness": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/click-readiness.e2e.test.js",
    "test:e2e:downloads": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/downloads.e2e.test.js",
    "test:e2e:traces": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/traces.e2e.test.js",
    "test:e2e:cli": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/cli.e2e.test.js",
    "test:e2e:api-coverage": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/api-coverage.e2e.test.js",
    "test:e2e:google-probe": "node scripts/run-tests.mjs --env RUN_E2E=true --env RUN_GOOGLE_PROBE=true tests/e2e/google-signin-probe.e2e.test.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "jsdoc -c jsdoc.json",
    "check:duplication": "jscpd . --baseline .jscpd-baseline.json --fail-on-new-clones",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "check:duplication:update": "jscpd . --baseline .jscpd-baseline.json --update-baseline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/browser-commander.git"
  },
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "puppeteer",
    "selenium",
    "webdriver",
    "testing",
    "e2e"
  ],
  "author": "",
  "license": "UNLICENSE",
  "bugs": {
    "url": "https://github.com/link-foundation/browser-commander/issues"
  },
  "homepage": "https://github.com/link-foundation/browser-commander#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "playwright": ">=1.63.0",
    "puppeteer": ">=25.12.0",
    "selenium-webdriver": ">=4.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    },
    "selenium-webdriver": {
      "optional": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "bplist-parser": "^0.5.0",
    "command-stream": "^1.4.0",
    "csv-parse": "^7.0.3",
    "links-notation": "^0.22.0",
    "log-lazy": "^1.0.4",
    "plist": "^5.0.0",
    "test-anywhere": "^0.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jscpd": "^5.4.0",
    "jsdoc": "^4.0.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "selenium-webdriver": "^4.50.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "node-pty": false,
    "puppeteer": false
  }
}

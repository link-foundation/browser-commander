{
  "name": "browser-commander",
  "version": "0.17.2",
  "description": "Universal browser automation library that supports both Playwright and Puppeteer with a unified API",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./tests": "./src/tests/index.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs --reporter spec tests/unit",
    "test:unit": "node scripts/run-tests.mjs --reporter spec tests/unit",
    "test:coverage": "node scripts/run-tests.mjs --coverage tests/unit",
    "test:e2e": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e",
    "test:e2e:playwright": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/playwright.e2e.test.js",
    "test:e2e:puppeteer": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/puppeteer.e2e.test.js",
    "test:e2e:parity": "node scripts/run-tests.mjs --env RUN_E2E=true tests/e2e/fingerprint-parity.e2e.test.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "jsdoc -c jsdoc.json",
    "check:duplication": "jscpd . --baseline .jscpd-baseline.json --fail-on-new-clones",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "check:duplication:update": "jscpd . --baseline .jscpd-baseline.json --update-baseline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/browser-commander.git"
  },
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "puppeteer",
    "testing",
    "e2e"
  ],
  "author": "",
  "license": "UNLICENSE",
  "bugs": {
    "url": "https://github.com/link-foundation/browser-commander/issues"
  },
  "homepage": "https://github.com/link-foundation/browser-commander#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "puppeteer": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "log-lazy": "^1.0.4",
    "test-anywhere": "^0.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jscpd": "^5.1.2",
    "jsdoc": "^4.0.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0"
  }
}

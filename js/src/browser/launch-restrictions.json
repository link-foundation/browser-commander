{
  "restrictions": [
    {
      "id": "no-first-run",
      "description": "Skip first-run UI with the switch instead of the First Run sentinel file Browser Commander already writes.",
      "args": ["--no-first-run"]
    },
    {
      "id": "no-default-browser-check",
      "description": "Hide the \"Chrome isn't your default browser\" infobar that a hand-started Chrome shows.",
      "args": ["--no-default-browser-check"]
    },
    {
      "id": "no-crash-restore",
      "description": "Hide the restore-pages bubble after an unclean exit.",
      "args": [
        "--disable-session-crashed-bubble",
        "--hide-crash-restore-bubble",
        "--disable-crash-restore"
      ],
      "disableFeatures": ["SessionRestoreInfobar"]
    },
    {
      "id": "no-infobars",
      "description": "Legacy switch; current Chrome ignores it and still shows the unsupported-flag infobar.",
      "args": ["--disable-infobars"]
    },
    {
      "id": "basic-password-store",
      "description": "Store passwords and cookie keys unencrypted instead of in libsecret/KWallet. Real-profile data cannot be decrypted or migrated.",
      "args": ["--password-store=basic"]
    },
    {
      "id": "mock-keychain",
      "description": "Use a mock macOS Keychain. Real-profile data cannot be decrypted or migrated.",
      "args": ["--use-mock-keychain"]
    },
    {
      "id": "no-extensions",
      "description": "Disable extensions, component extensions with background pages and default apps.",
      "args": [
        "--disable-extensions",
        "--disable-component-extensions-with-background-pages",
        "--disable-default-apps"
      ]
    },
    {
      "id": "no-sync",
      "description": "Disable Chrome sync.",
      "args": ["--disable-sync"]
    },
    {
      "id": "no-google-services",
      "description": "Override the built-in Google API keys for the browser process only; disables Chrome sign-in, sync, Safe Browsing and other Google services. The host process environment is never changed.",
      "env": {
        "GOOGLE_API_KEY": "no",
        "GOOGLE_DEFAULT_CLIENT_ID": "no",
        "GOOGLE_DEFAULT_CLIENT_SECRET": "no"
      }
    },
    {
      "id": "no-translate",
      "description": "Disable the Translate feature and its bubble.",
      "disableFeatures": ["Translate"],
      "preferences": {
        "translate": {
          "enabled": false
        }
      }
    },
    {
      "id": "no-component-update",
      "description": "Disable component updates (Widevine, CRLSets, Safe Browsing lists).",
      "args": ["--disable-component-update"]
    },
    {
      "id": "no-background-networking",
      "description": "Disable background networking such as variations and update checks.",
      "args": ["--disable-background-networking"]
    },
    {
      "id": "no-popup-blocking",
      "description": "Never block popups; pages can observe this.",
      "args": ["--disable-popup-blocking"]
    },
    {
      "id": "no-phishing-detection",
      "description": "Disable client-side phishing detection.",
      "args": ["--disable-client-side-phishing-detection"]
    },
    {
      "id": "no-https-upgrades",
      "description": "Disable automatic HTTPS upgrades.",
      "disableFeatures": ["HttpsUpgrades"]
    },
    {
      "id": "no-media-router",
      "description": "Disable Cast/Media Router and global media controls.",
      "disableFeatures": [
        "MediaRouter",
        "DialMediaRouteProvider",
        "GlobalMediaControls"
      ]
    },
    {
      "id": "no-lens",
      "description": "Disable the Lens overlay.",
      "disableFeatures": ["LensOverlay"]
    },
    {
      "id": "no-background-throttling",
      "description": "Keep hidden tabs at full speed; pages can observe this.",
      "args": [
        "--disable-background-timer-throttling",
        "--disable-renderer-backgrounding",
        "--disable-backgrounding-occluded-windows"
      ]
    },
    {
      "id": "no-back-forward-cache",
      "description": "Disable the back/forward cache; pageshow.persisted is always false.",
      "args": ["--disable-back-forward-cache"]
    },
    {
      "id": "srgb-color-profile",
      "description": "Force the sRGB colour profile; changes rendered colours.",
      "args": ["--force-color-profile=srgb"]
    },
    {
      "id": "start-maximized",
      "description": "Start with a maximized window.",
      "args": ["--start-maximized"]
    },
    {
      "id": "no-save-bubbles",
      "description": "Suppress password and payment-card saving bubbles and browser promos.",
      "disableFeatures": [
        "AutofillSaveCardUi",
        "ChromeWhatsNewUI",
        "PromotionalTabs"
      ],
      "preferences": {
        "credentials_enable_service": false,
        "profile": {
          "password_manager_enabled": false
        },
        "autofill": {
          "credit_card_enabled": false
        }
      }
    }
  ],
  "presets": {
    "legacy-defaults": [
      "no-crash-restore",
      "no-infobars",
      "basic-password-store",
      "no-first-run",
      "no-default-browser-check"
    ],
    "legacy-launch-browser": [
      "no-crash-restore",
      "no-infobars",
      "basic-password-store",
      "no-first-run",
      "no-default-browser-check",
      "no-google-services",
      "no-translate"
    ],
    "quiet-ui": [
      "no-first-run",
      "no-default-browser-check",
      "no-crash-restore",
      "no-translate",
      "no-save-bubbles"
    ]
  }
}

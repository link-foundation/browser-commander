        "win32": ["{localAppData}/Google/Chrome/User Data"],
        "linux": ["{config}/google-chrome"]
      },
      "safeStorage": {
        "service": "Chrome Safe Storage",
        "application": "chrome",
        "folder": "Chrome Keys"
      },
      "default": {
        "darwin": ["com.google.chrome"],
        "linux": ["google-chrome.desktop", "google-chrome-stable.desktop"],

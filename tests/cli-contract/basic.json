{
  "steps": [
    { "method": "version" },
    { "method": "session.launch", "params": { "headless": true } },
    {
      "method": "page.goto",
      "params": {
        "session": "$session",
        "url": "data:text/html,%3Ctitle%3ECLI%20contract%3C%2Ftitle%3E%3Cinput%20id%3D%22name%22%3E%3Cbutton%20id%3D%22go%22%20onclick%3D%22document.title%3D'Hello%20'%2Bdocument.getElementById('name').value%3Bdocument.getElementById('out').textContent%3Ddocument.title%22%3EGo%3C%2Fbutton%3E%3Cp%20id%3D%22out%22%3E%3C%2Fp%3E"
      }
    },
    {
      "method": "page.fill",
      "params": { "session": "$session", "selector": "#name", "value": "Ada" }
    },
    {
      "method": "page.click",
      "params": { "session": "$session", "selector": "#go" }
    },
    {
      "method": "page.eval",
      "params": {
        "session": "$session",
        "expression": "[document.title, document.querySelector('#name').value, document.querySelector('#out').textContent]"
      }
    },
    { "method": "session.close", "params": { "session": "$session" } }
  ]
}
